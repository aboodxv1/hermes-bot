# ─────────────────────────────────────────────────────────
# Hermes Telegram Email Bot — Environment Template
# Copy this file to hermes-data/.env and fill in real values.
# NEVER commit the real .env to git.
# ─────────────────────────────────────────────────────────

# OpenRouter API key — get one free at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Telegram bot token — create a bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=000000000:REPLACE_ME

# Your numeric Telegram user ID — get yours from @userinfobot
TELEGRAM_ALLOWED_USERS=000000000

# Optional: Groq API key for faster/cheaper inference
# GROQ_API_KEY=gsk_REPLACE_ME
